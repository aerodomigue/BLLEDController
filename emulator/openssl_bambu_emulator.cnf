[ req ]
default_bits       = 2048
distinguished_name = req_distinguished_name
req_extensions     = req_ext
x509_extensions    = v3_ca
prompt             = no

[ req_distinguished_name ]
C  = US
ST = State
L  = City
O  = BambuEmulator
OU = Dev
CN = bambu-emulator.local

[ req_ext ]
subjectAltName = @alt_names

[ v3_ca ]
subjectAltName = @alt_names
basicConstraints = CA:TRUE

[ alt_names ]
DNS.1   = localhost
DNS.2   = bambu-emulator.local
IP.1    = 127.0.0.1
IP.2    = 0.0.0.0
